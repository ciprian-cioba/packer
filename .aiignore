# Files and directories the packer should skip.
# Same glob syntax as .gitignore for our purposes: `*` and `?` wildcards.

.git
node_modules
.env
.env.*
dist
build
out
.next
.nuxt
coverage
.cache
__pycache__
.venv
venv
target
vendor

# Binaries and archives
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.ico
*.pdf
*.zip
*.tar
*.gz
*.exe
*.dll
*.so
*.dylib
*.woff
*.woff2
*.ttf
*.eot

# Lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
Cargo.lock
poetry.lock
Gemfile.lock
composer.lock
